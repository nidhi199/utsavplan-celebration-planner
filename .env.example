# Server Port (default: 8080 in production / render, 3000 in local dev)
PORT=8080

# Application URL
APP_URL="http://localhost:8080"

# LLM Fallback Ladder configuration
# Comma-separated list of providers to try in order: gemini, groq, openrouter
LLM_LADDER="gemini,groq,openrouter"

# Cooldown duration in seconds when a provider hits rate-limits or quota errors
LLM_COOLDOWN_SECONDS=60

# Provider API Keys (leave empty or omit to skip a provider)
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

GEMINI_MODEL="gemini-3.5-flash"
GROQ_MODEL="llama-3.3-70b-versatile"
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"
